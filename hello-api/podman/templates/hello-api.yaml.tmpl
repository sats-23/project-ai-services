apiVersion: v1
kind: Pod
metadata:
  name: "{{ .InstanceSlug }}--hello-api"
  labels:
    ai-services.io/template: "{{ .TemplateID }}"
  annotations:
    # Routes port 8080 inside the pod through Caddy as an API endpoint.
    ai-services.io/routes: "8080:hello-api-{{ .InstanceSlug }}:api"
spec:
  containers:
    - name: hello-api
      image: "{{ .Values.helloapi.image }}"
      ports:
        - containerPort: 8080
      # Write greeting.json and a minimal nginx config on port 8080, then start nginx.
      command:
        - /bin/sh
        - -c
        - |
          mkdir -p /usr/share/nginx/html
          cat > /usr/share/nginx/html/greeting.json <<'GREETEOF'
          {"greeting":"{{ .Values.helloapi.greeting }}"}
          GREETEOF
          cat > /etc/nginx/conf.d/default.conf <<'NGINXEOF'
          server {
              listen 8080;
              root /usr/share/nginx/html;
              location / {
                  try_files $uri $uri/ =404;
              }
          }
          NGINXEOF
          exec nginx -g 'daemon off;'
